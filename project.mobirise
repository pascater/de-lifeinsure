          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#dfdbd7\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n\n            <div class=\"card col-12 col-md-8\" mbr-if=\"cardsAmount > 0\" mbr-class=\"{'col-lg-6': cardsAmount < '3', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-img\">\n                    <h4 class=\"price align-right mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".price\"><b>4 Fr.</b></h4>\n                    <p class=\"price-text align-right mbr-regular mbr-fonts-style pt-2 align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".price-text\"><b><i>Al mese</i></b></p>\n                </div>\n                <div class=\"card-box\">\n                    <h4 class=\"card-title align-left mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>POLIZZA VITA </b>caso morte<b> <i>BASE.</i>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; </b><b>50.000€ </b>di capitale assicurato.</h4>\n                    <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Costo di tariffa basato su un esempio relativo ad un uomo di 25 anni, non fumatore durata polizza: 10 anni.&nbsp;</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"align-left mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-success\" href=\"https://www.afi-esca.it/preventivo/assicurazione-vita?ag=cat11223&c=4863094621\" data-app-placeholder=\"Type Text\" target=\"_blank\">Scegli o personalizza questa soluzione</a></div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-8\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-6': cardsAmount < '3', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-img\">\n                    <h4 class=\"price align-right  mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".price\"><b>19 Fr.</b></h4>\n                    <p class=\"price-text mbr-fonts-style pt-2 align-right \" mbr-theme-style=\"display-7\" data-app-selector=\".price-text\"><b><i>Al mese</i></b></p>\n                </div>\n                <div class=\"card-box\">\n                    <h4 class=\"card-title align-left mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>POLIZZA VITA </b>caso morte<b> </b><b><i>COMPLETA</i>.</b><br><b>150.000€</b> di capitale assicurato.<br></h4>\n                    <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Tariffa basata su un esempio relativo ad una donna di 36 anni, non fumatrice, durata 15 anni.</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"align-left mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-danger\" href=\"https://www.afi-esca.it/preventivo/assicurazione-vita?ag=cat11223&c=4863094621\" data-app-placeholder=\"Type Text\" target=\"_blank\">Fai un preventivo con questo esempio</a></div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-8\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-6': cardsAmount < '3', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-img\">\n                    <h4 class=\"price align-right mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".price\"><b>47 Fr.</b></h4>\n                    <p class=\"price-text mbr-fonts-style pt-2 align-right \" mbr-theme-style=\"display-7\" data-app-selector=\".price-text\"><b><i>Al mese</i></b></p>\n                </div>\n                <div class=\"card-box\">\n                    <h4 class=\"card-title align-left mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>POLIZZA VITA </b>caso morte<b> <i>SPECIALE</i>.</b><br><b>200.000€ </b>di capitale assicurato.</h4>\n                    <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Costo di tariffa basato su un esempio relativo ad un soggetto di 47 anni, uomo; durata polizza: 20 anni.</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"align-left mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-secondary\" href=\"https://www.afi-esca.it/preventivo/assicurazione-vita?ag=cat11223&c=4863094621\" data-app-placeholder=\"Type Text\" target=\"_blank\">Scegli questo massimale&nbsp;</a></div>\n                </div>\n            </div>\n\n        </div>\n\n    </div>\n\n</section>",
          "_anchor": "pricing-tables02-4",
          "_isUserblock": true,
          "_cid": "uwdoIGE4EK",
          "_protectedParams": [],
