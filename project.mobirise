          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#dfdbd7\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n\n            <div class=\"card col-12 col-md-8\" mbr-if=\"cardsAmount > 0\" mbr-class=\"{'col-lg-6': cardsAmount < '3', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-img\">\n                    <h4 class=\"price align-right mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".price\"><b>4 Fr.</b></h4>\n                    <p class=\"price-text align-right mbr-regular mbr-fonts-style pt-2 align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".price-text\"><i><b>Im Monat</b></i><br></p>\n                </div>\n                <div class=\"card-box\">\n                    <h4 class=\"card-title align-left mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><font color=\"#57468b\"><i>LEBENSINSURANZ IM TODESFALLRISIKO BASIC. <b>50.000€ </b>versicherter Kapitalbetrag.</i></font></h4>\n                    <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Tarifbeispiel für einen 25-jährigen Nichtraucher, Laufzeit der Versicherung 10 Jahre. </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"align-left mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-success\" href=\"https://www.afi-esca.it/preventivo/assicurazione-vita?ag=cat11223&c=4863094621\" data-app-placeholder=\"Type Text\" target=\"_blank\">Wählen oder passen Sie diese Lösung an oder passen Sie an</a></div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-8\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-6': cardsAmount < '3', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-img\">\n                    <h4 class=\"price align-right  mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".price\"><b>19 Fr.</b></h4>\n                    <p class=\"price-text mbr-fonts-style pt-2 align-right \" mbr-theme-style=\"display-7\" data-app-selector=\".price-text\"><i><b>Im Monat</b></i><br></p>\n                </div>\n                <div class=\"card-box\">\n                    <h4 class=\"card-title align-left mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><font color=\"#57468b\"><i style>LEBENSINSURANZ IM TODESFALLRISIKO COMPLETE.</i></font><div><font color=\"#57468b\"><i style><b>150.000€ v</b>ersicherter Kapitalbetrag.</i></font></div></h4>\n                    <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Tarifbeispiel für eine 36-jährige Nichtraucherin, Laufzeit der Versicherung 15 Jahre.</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"align-left mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-danger\" href=\"https://www.afi-esca.it/preventivo/assicurazione-vita?ag=cat11223&c=4863094621\" data-app-placeholder=\"Type Text\" target=\"_blank\">Machen Sie ein Zitat mit diesem Beispiel</a></div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-8\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-6': cardsAmount < '3', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-img\">\n                    <h4 class=\"price align-right mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".price\"><b>47 Fr.</b></h4>\n                    <p class=\"price-text mbr-fonts-style pt-2 align-right \" mbr-theme-style=\"display-7\" data-app-selector=\".price-text\"><b><i>Im Monat</i></b><br></p>\n                </div>\n                <div class=\"card-box\">\n                    <h4 class=\"card-title align-left mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><font color=\"#57468b\"><i style>LEBENSINSURANZ IM TODESFALLRISIKO SPECIAL.</i></font><div><font color=\"#57468b\"><i style><b>200.000€</b> versicherter Kapitalbetrag.</i></font></div></h4>\n                    <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Tarifbeispiel für einen 47-jährigen Mann, Laufzeit der Versicherung 20 Jahre.</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"align-left mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-secondary\" href=\"https://www.afi-esca.it/preventivo/assicurazione-vita?ag=cat11223&c=4863094621\" data-app-placeholder=\"Type Text\" target=\"_blank\">Wählen Sie diese Richtliniendecke&nbsp;</a></div>\n                </div>\n            </div>\n\n        </div>\n\n    </div>\n\n</section>",
