            },
            ".card-img span": {
              "font-size": "96px",
              "color": "#149dcc",
              "padding": "0.6rem",
              "margin-right": "1.5rem",
              "border-radius": "8px"
            },
            "p": {
              "margin": "0"
            },
            ".card-img .img1": {
              "background-color": "@iconColor1"
