          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-text": {
              "color": "#343351",
              "line-height": "2"
            },
            ".price-text": {
              "line-height": "1.5",
              "color": "#491414",
              "text-align": "left"
            },
            ".card-title": {
              "line-height": "1.5",
              "color": "#491414",
              "padding-top": "2rem",
              "text-align": "left"
            },
            ".card-img": {
              "padding-right": "2rem"
            },
            ".card": {
              "display": "flex",
              "justify-content": "center",
              "flex-direction": "row",
              "transition": "all 0.3s",
              "padding": "3rem 1.5rem !important",
              "&:hover": {
                "box-shadow": "0 10px 55px 5px rgba(137, 173, 255, 0.35)"
              }
            },
            "@media (max-width: 992px)": {
              ".align-right, .align-left": {
                "text-align": "center"
              },
              ".card-title": {
                "padding-top": "0rem"
              },
              ".price": {
                "margin-bottom": "0"
              },
              ".card": {
                "flex-direction": "column",
                "align-items": "center",
                "padding": "2rem 0!important",
                ".card-img": {
                  "margin-bottom": "0rem"
                },
                "&:hover": {
                  "transform": "none"
                }
              },
              ".card-img": {
                "padding": "0"
              }
            },
            "@media (max-width: 576px)": {
              ".card": {
                "&:hover": {
                  "box-shadow": "none"
                }
              }
            },
            ".btn": {
              "padding": "0.8rem 1.8rem",
              "margin": "0!important",
              "margin-top": "0.5rem"
            },
            ".price": {
              "color": "#1d5356",
              "text-align": "left"
            },
            ".card-title B": {
              "color": "#57468b"
            }
