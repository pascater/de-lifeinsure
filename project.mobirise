              "font-size": "(@IconSize * 1rem) !important"
            },
            ".card": {
              "display": "flex",
              "flex-direction": "row",
              "transition": "all 0.3s",
              "padding": "2rem 1.5rem !important",
              "&:hover": {
                "box-shadow": "0 10px 55px 5px rgba(137, 173, 255, 0.35)",
                "transform": "translateY(-1rem)"
              }
            },
            ".card-title, .card-img": {
              "color": "#57468b"
            },
            "@media (max-width: 992px)": {
              ".card": {
                "justify-content": "center"
              }
